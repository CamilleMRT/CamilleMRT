# --- Database (optional, for server sync + Web Push) ---------------------
# Vercel Postgres or Supabase. Leave unset to run purely local-first
# (localStorage is the source of truth; the app is fully usable offline).
DATABASE_URL="postgresql://user:password@host:5432/carnet?sslmode=require"

# --- App protection ------------------------------------------------------
# Single user, no auth. A shared secret gates the sync endpoint.
APP_SECRET="change-me-long-random"

# --- Web Push (VAPID) — the contextual bonus layer -----------------------
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:camillemarante@gmail.com"
# The public key must ALSO be exposed to the client for subscription:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- External cron -------------------------------------------------------
# Protects /api/cron/notify. Set the same value in cron-job.org requests.
CRON_SECRET="change-me-cron-secret"
